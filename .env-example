# Database Configuration
# URL de connexion à la base de données PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# Security
# Token secret pour l'authentification des routes protégées
SECRET_TOKEN="your-secret-token-here"

# RPC
RPC_URL="https://eth-mainnet.g.alchemy.com/v2/your-key"

# Monitoring Thresholds (all optional, defaults shown)

# Collateralization ratio - multipliers applied to liquidation_threshold
MONITORING_COLLAT_WARNING_MULT=1.2
MONITORING_COLLAT_DANGER_MULT=1.1
MONITORING_COLLAT_CRITICAL_MULT=1.03

# Liquidation distance (%)
MONITORING_LIQDIST_SAFE_PCT=5.0
MONITORING_LIQDIST_WARNING_PCT=2.0
MONITORING_LIQDIST_DANGER_PCT=1.0
MONITORING_LIQDIST_CRITICAL_PCT=0.5

# Peg deviation (%)
MONITORING_PEG_SAFE_PCT=0.5
MONITORING_PEG_WARNING_PCT=2.0
MONITORING_PEG_DANGER_PCT=5.0

# Price variation - stable assets (% abs)
MONITORING_PRICEVAR_STABLE_5M=0.3
MONITORING_PRICEVAR_STABLE_15M=0.5
MONITORING_PRICEVAR_STABLE_1H=1.0
MONITORING_PRICEVAR_STABLE_4H=2.0

# Price variation - volatile assets (% abs)
MONITORING_PRICEVAR_VOLATILE_5M=2.0
MONITORING_PRICEVAR_VOLATILE_15M=5.0
MONITORING_PRICEVAR_VOLATILE_1H=10.0
MONITORING_PRICEVAR_VOLATILE_4H=15.0

# Oracle sanity
MONITORING_ORACLE_DEV_WARNING_PCT=2.0
MONITORING_ORACLE_DEV_DANGER_PCT=5.0
MONITORING_ORACLE_AGE_WARNING_S=3600
MONITORING_ORACLE_AGE_DANGER_S=7200

# Debt utilization (%)
MONITORING_DEBT_WARNING_PCT=85.0
MONITORING_DEBT_DANGER_PCT=95.0

# TVL variation (% absolute drop threshold)
MONITORING_TVL_WARNING_1H_PCT=10.0
MONITORING_TVL_DANGER_1H_PCT=15.0
MONITORING_TVL_WARNING_24H_PCT=20.0
MONITORING_TVL_DANGER_24H_PCT=30.0
